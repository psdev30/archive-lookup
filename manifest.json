{
  "manifest_version": 3,
  "name": "Open in archive.ls",
  "version": "1.0.0",
  "description": "Look up the current page on archive.ls with one click.",
  "permissions": [
    "activeTab"
  ],
  "action": {
    "default_title": "Look up this page on archive.ls",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
